#!/usr/bin/env sh
set -eu
BASE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CACHE="$BASE/.mvn/cache"
VERSION=3.9.11
MAVEN="$CACHE/apache-maven-$VERSION"
if [ ! -x "$MAVEN/bin/mvn" ]; then
  mkdir -p "$CACHE"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$VERSION/apache-maven-$VERSION-bin.tar.gz"
  curl --fail --location --silent --show-error "$URL" -o "$CACHE/maven.tar.gz"
  curl --fail --location --silent --show-error "$URL.sha512" -o "$CACHE/maven.sha512"
  (cd "$CACHE" && printf '%s  maven.tar.gz\n' "$(cat maven.sha512)" | sha512sum --check --status)
  tar -xzf "$CACHE/maven.tar.gz" -C "$CACHE"
fi
cd "$BASE"
exec "$MAVEN/bin/mvn" --strict-checksums -f "$BASE/pom.xml" "-Dmaven.repo.local=$CACHE/repository" "$@"
